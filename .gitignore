# Publisher credentials and acknowledgements (docs/live-results.md: never commit)
.result-feed/

# Lean toolchain + Mathlib oleans — 7.2 GB, rebuilt by `lake build`
formal/.lake/
formal/lake-manifest.json.bak

# Node
erdos-atlas/node_modules/
erdos-atlas/dist/
erdos-atlas/.next/
erdos-atlas/tsconfig.tsbuildinfo

# Python bytecode
__pycache__/
*.py[cod]

# Run output: 76 MB and growing, regenerable, churns on every run.
# NOTE: knowledge/solved/ is NOT ignored — verified proofs are the durable artifact.
runs/
programs/
tmp/

# macOS
.DS_Store

# The Atlas site is its own repository (github.com/nkudeba/erdos-atlas),
# checked out here so the ranker can write app/data.json in place.
erdos-atlas/

# atomic-write lock and temp files (atlas-data/atomic.py)
.*.lock
.*.tmp

# Test debris: the reduce/escalate tests write into the real knowledge dir under a synthetic problem id
knowledge/reductions/99273/

# Pinned harness copies for multi-day benchmark evaluations (benchmarks/timesplit/timesplit.py pin)
pin_*_harness.py
# ...except a pin whose exact contents are in no commit and that produced a recorded result: 84f21c5 ran both
# verified #1213 solves (benchmarks/timesplit/evidence/1213). The other pins are recoverable from history.
!pin_84f21c561c540e02_harness.py

# timesplit literature libraries: raw third-party paper texts stay local (manifest.json records id, date and sha256,
# so `timesplit.py library` can rebuild them); manifests, digests and statements are committed
benchmarks/timesplit/library/*/papers/
experiments/*/library/*/papers/
